# Copy this file to .env.local and fill in the keys you have.
# Every key is optional, but you need at least ONE data source.
# These values are only read on the server and are never sent to the browser.

# --- Claude (analysis + web search) ------------------------------------------
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Model used for web research and analysis.
ANTHROPIC_MODEL=claude-opus-5
# Set to false to turn off Claude web search (it is billed per search).
ENABLE_WEB_SEARCH=true
# Maximum web searches per research run.
WEB_SEARCH_MAX_USES=8

# --- Etsy Open API v3 --------------------------------------------------------
# Create an app at https://www.etsy.com/developers/your-apps
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# --- eBay Browse API ---------------------------------------------------------
# Production keyset from https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# --- Google Shopping via SerpApi (paid) --------------------------------------
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
SERPAPI_COUNTRY=us

# --- Database ----------------------------------------------------------------
DROP_LAB_DB_PATH=data/drop-lab.db
